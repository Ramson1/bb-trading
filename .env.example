# Defaults mirror bc.js strategy with base bet fixed at ₦50 (site minimum)
PORT=1004
AUTO_START=0          # 1 = auto-start, 0 = click Start Bot on dashboard
DRY_RUN=1             # 1 = dry-run only (no real bets); force dry-run mode
LIVE=0                # 1 = start live immediately (use with caution)
TEST_BET=50           # first bet amount when going live
BASE_BET=50           # fixed base bet (always ₦50 - site minimum)
MAX_BET=0             # 0 = no cap (bc.js style); set a number to cap bets

# Recovery engine parameters (bc.js style)
PAYOUT=1.1            # normal cashout multiplier
RECOVERY_PAYOUT=1.1   # recovery cashout multiplier
RECOVERY_STEP_INC=300  # bet increment after each recovery loss (+₦50 per loss)
MAX_LOSSES=15         # stop after this many consecutive losses
TARGET_PERCENT=3      # target profit % per session (3% of start balance)

# Session control
AUTO_RESTART=1        # 1 = auto-start new session after target/reach; 0 = stop
MAX_SESSION_LOSS=0    # 0 = no loss limit; set N to stop if loss > ₦N

NOTIFY_ENABLED=1      # 1 = send webhook on stop
WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyQC3B85Mhk1GFCNo4fd9HIawRlnWe8ALOTKez4zF8Q--6Rr7H_J8YEA6dPsTIoKgKq_w/exec
