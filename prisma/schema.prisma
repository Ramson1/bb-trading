generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String   @id @default(cuid())
  startBalance  Float
  endBalance    Float?
  targetProfit  Float
  baseBet       Float
  payout        Float
  maxLosses     Int
  wins          Int      @default(0)
  losses        Int      @default(0)
  status        String   @default("running")
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  rounds        Round[]
}

model Round {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result        String
  amount        Float
  payout        Float
  multiplier    Float
  profit        Float
  balanceAfter  Float
  mode          String
  betBefore     Float
  timestamp     DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
